# Copy this file to .env.local and fill in your Supabase project values.
# Both are safe to expose to the browser (publishable / anon key only).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Razorpay — put these in .env (local) and the Vercel dashboard (production).
# The SECRET is server-side only and must never be exposed to the browser.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Frontend key id (safe to expose — key id only, never the secret).
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Supabase server-side admin (staff management via /api/staff/*). Put these in
# .env (local) and the Vercel dashboard (production). The service_role key is a
# SECRET — never expose it to the browser / never prefix with VITE_.
# Find it in Supabase Dashboard → Project Settings → API → service_role.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
